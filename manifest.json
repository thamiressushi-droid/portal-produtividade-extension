{
  "manifest_version": 3,
  "name": "Portal Produtividade",
  "version": "1.0.0",
  "description": "Monitoramento de sites ativos para o Portal de Produtividade.",

  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "alarms",
    "idle"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://*.supabase.co/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://*.app.github.dev/*",
        "https://portal-produtividade.gehaka.workers.dev/*"
      ],
      "js": [
        "content-portal-identity.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-activity.js"
      ],
      "run_at": "document_start"
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  }
}