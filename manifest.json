{
  "manifest_version": 3,
  "name": "Portal Produtividade",
  "version": "1.0.0",
  "description": "Monitoramento de sites ativos para o Portal de Produtividade.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}