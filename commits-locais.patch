+      { tabId: currentSession.tabId, reason }
+    );
+  }
+
+  const resumedAt = new Date(timestamp).toISOString();
+  currentSession.intervalStart = resumedAt;
+  currentSession.lastActivity = resumedAt;
+  currentSession.isActive = true;
